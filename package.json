{
  "name": "traceroot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TraceRoot Monorepo: Frontend (Mobile), Backend (Edge Functions), and Database (PostgreSQL)",
  "scripts": {
    "start": "npm start --prefix frontend",
    "android": "npm run android --prefix frontend",
    "ios": "npm run ios --prefix frontend",
    "web": "npm run web --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "db:push": "supabase db push --workdir database",
    "backend:deploy": "supabase functions deploy --workdir backend"
  }
}
